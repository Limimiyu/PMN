#Sample integrated
assays <- c("HC1","HC2", "HC3","MN1","MN2", "MN3","MN4","MN5")
dir=paste0("data5/practice/HE/",assays)
samples_names=c("HC1","HC2", "HC3","MN1","MN2", "MN3","MN4","MN5")
scRNAlist <- list()
PMN.function <- function(sample_dir, sample_name, group) {
  counts <- Read10X(data.dir = sample_dir)
  scRNA <- CreateSeuratObject(counts, project = sample_name, min.cells = 3, min.features = 200)
  scRNA <- RenameCells(scRNA, add.cell.id = sample_name)
  scRNA[["percent.mt"]] <- PercentageFeatureSet(scRNA, pattern = "^MT-")
  scRNA <- subset(scRNA, nFeature_RNA > 600 & nFeature_RNA < 5000 & percent.mt < 20)
  scRNA$group <- group
  return(scRNA)
}

VlnPlot(PMN, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3,pt.size = 0 )

for (i in 1:length(dir)) {
  group <- ifelse(i <= 3, "healthy", "PMN")
  scRNAlist[[i]] <- PMN.function(dir[i], samples_names[i], group)
}

PMN.list <- lapply(X = scRNAlist, FUN = function(x) {
       x <- NormalizeData(x)
       x <- FindVariableFeatures(x, selection.method = "vst", nfeatures = 2000)
   })

features <- SelectIntegrationFeatures(object.list = PMN.list)
anchors <- FindIntegrationAnchors(object.list = PMN.list, anchor.features = features)
PMN <- IntegrateData(anchorset = anchors)
DefaultAssay(PMN) <- "integrated"
PMN <- ScaleData(PMN, verbose = FALSE)
PMN <- RunPCA(PMN, npcs = 30, verbose = FALSE)
ElbowPlot(PMN,ndims = 20)
PMN <- RunUMAP(PMN, reduction = "pca", dims = 1:15)
PMN <- FindNeighbors(PMN, dims = 1:15)
PMN <- FindClusters(PMN, resolution = 0.4)
DefaultAssay(PMN) <- "RNA"
DimPlot(PMN,reduction = "umap",label = TRUE)
DimPlot(PMN,reduction = "umap",group.by = "orig.ident")
DefaultAssay(PMN) <- "RNA"
